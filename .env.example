# PostgreSQL
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_USER=ccash
POSTGRES_PASSWORD=ccash_secret_2024
POSTGRES_DB=ccash
DATABASE_URL=postgresql+asyncpg://ccash:ccash_secret_2024@postgres:5432/ccash

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=ccash
RABBITMQ_PASSWORD=ccash_secret_2024
RABBITMQ_URL=amqp://ccash:ccash_secret_2024@rabbitmq:5672/

# JWT
JWT_SECRET_KEY=change-this-to-a-random-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Mailpit (Email testing)
MAILPIT_SMTP_HOST=mailpit
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
MAIL_FROM=noreply@ccash.ph

# Frontend
VITE_API_URL=http://localhost/api
VITE_WS_URL=ws://localhost/ws

# pgAdmin
PGADMIN_EMAIL=admin@ccash.ph
PGADMIN_PASSWORD=admin

# Monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
LOKI_PORT=3100